# Managed by Ansible (fedora/roles/niri/files/ghostty.config).
# Personal settings go in ~/.config/ghostty/local, loaded last.

font-family = JetBrains Mono
font-size = 11
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
cursor-style = bar
mouse-hide-while-typing = true

# Graphite: the Noctalia palette's terminal colors. Grays carry the text;
# red, yellow and green are kept for errors, warnings and success.
background = #0a0a0b
foreground = #e6e6e8
cursor-color = #f2f2f3
cursor-text = #0a0a0b
selection-background = #3a3a3f
selection-foreground = #ffffff
palette = 0=#1c1c1f
palette = 1=#e5534b
palette = 2=#87b07a
palette = 3=#d4a95a
palette = 4=#9aa4b2
palette = 5=#a99fb5
palette = 6=#9fb3b0
palette = 7=#c8c8cc
palette = 8=#5a5a61
palette = 9=#f07068
palette = 10=#9cc48e
palette = 11=#e3bd72
palette = 12=#b4bdc9
palette = 13=#c0b7cb
palette = 14=#b5c7c4
palette = 15=#f4f4f5

# Glass. Niri blurs the wallpaper behind the window (config.kdl); text stays
# fully opaque because only the background is translucent.
background-opacity = 0.84
background-blur = true

# Niri draws no title bars (prefer-no-csd), so Ghostty's own header is hidden.
gtk-titlebar = false
window-decoration = none

# On SSH, advertise xterm-256color instead of xterm-ghostty, which most servers
# don't have a terminfo entry for (the usual cause of "unknown terminal type").
shell-integration-features = ssh-env

config-file = ?local
