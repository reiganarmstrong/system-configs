# Managed by Ansible (fedora/roles/niri/files/ghostty.config).
# Personal settings go in ~/.config/ghostty/local, loaded last.

font-family = JetBrains Mono
font-size = 11
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
cursor-style = bar
mouse-hide-while-typing = true

# Graphite: the Noctalia palette's terminal colors. Clear, separate hues
# distinguish commands, paths, runtimes and status while the chrome stays gray.
background = #0a0a0b
foreground = #e6e6e8
cursor-color = #f2f2f3
cursor-text = #0a0a0b
selection-background = #3a3a3f
selection-foreground = #ffffff
palette = 0=#3c3c43
palette = 1=#ff5f57
palette = 2=#5fd38a
palette = 3=#f2c55c
palette = 4=#5ea8ff
palette = 5=#c58cff
palette = 6=#4fd6d0
palette = 7=#c8c8cc
palette = 8=#8b8b94
palette = 9=#ff7b72
palette = 10=#7ee2a0
palette = 11=#ffd77a
palette = 12=#8cc2ff
palette = 13=#d8acff
palette = 14=#7ee8e2
palette = 15=#f4f4f5

# Glass. Niri blurs the wallpaper behind the window (config.kdl); text stays
# fully opaque because only the background is translucent.
background-opacity = 0.84
background-blur = true

# Niri draws no title bars (prefer-no-csd), so Ghostty's own header is hidden.
gtk-titlebar = false
window-decoration = none

# On SSH, advertise xterm-256color instead of xterm-ghostty, which most servers
# don't have a terminfo entry for (the usual cause of "unknown terminal type").
shell-integration-features = ssh-env

config-file = ?local
