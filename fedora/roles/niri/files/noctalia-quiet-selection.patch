+  // Control-center toggles and the active sidebar tab. An active item keeps a solid OnSurface
+  // fill with Surface ink (white on dark themes, near-black on light) through hover and press;
+  // those states only let the panel show through a little, so ink never flips. An inactive
+  // press is a one-step lift instead of the Primary flash. Roles only, so theme switches follow.
+  // Callers must re-apply this after every setVariant(), which drops custom palettes.
+  inline Button::ButtonPalette quietPalette(ButtonVariant base, bool on) {
+    Button::ButtonPalette palette = Button::defaultPalette(base);
+    const auto active = [](float alpha) {
+      return Button::ButtonStateColors{
+          .bg = colorSpecFromRole(ColorRole::OnSurface, alpha),
+          .border = clearColorSpec(),
+          .label = colorSpecFromRole(ColorRole::Surface),
+      };
+    };
+    if (on) {
+      palette.normal = active(1.0F);
+      palette.hover = active(1.0F);
+      palette.pressed = active(0.88F);
+    } else {
+      palette.pressed = {
+          .bg = colorSpecFromRole(ColorRole::SurfaceContainerHighest),
+          .border = colorSpecFromRole(ColorRole::OutlineVariant),
+          .label = colorSpecFromRole(ColorRole::OnSurface),
+      };
+    }
+    if (palette.selected.has_value()) {
+      palette.selected = active(1.0F);
+    }
+    return palette;
+  }
+
 } // namespace panel_button_style
