// Managed by Ansible (fedora/roles/niri/files/fastfetch.jsonc).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "white", "2": "white" },
    "padding": { "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "90", "title": "white", "output": "default" },
    "key": { "width": 10 }
  },
  "modules": [
    "title",
    "os",
    "kernel",
    { "type": "wm", "key": "Session" },
    "shell",
    "terminal",
    "cpu",
    "memory",
    { "type": "disk", "folders": "/" },
    "battery",
    "uptime"
  ]
}
