# {{ ansible_managed }}
# Source: fedora/roles/niri/templates/noctalia.toml.j2. Ansible rewrites this
# file on every run. Noctalia merges every *.toml in this folder in
# alphabetical order, so a file that sorts later (for example local.toml) can
# override these values. Changes made in Noctalia's Settings window are saved
# to ~/.local/state/noctalia/settings.toml, which wins over both and which
# Ansible never touches.
# Reference: https://docs.noctalia.dev/noctalia/configuration/

[shell]
font_family = "Inter"
corner_radius_scale = 1.0
telemetry_enabled = false
# The role supplies the initial theme and wallpaper; the interactive wizard
# starts from built-in palette choices instead of this custom palette.
setup_wizard_enabled = false
# Noctalia is the session's polkit authentication agent; no other agent runs.
polkit_agent = true
niri_overview_close_on_launch_enabled = true

[shell.panel]
transparency_mode = "glass"
borders = true
border_color = "outline_variant"
border_width = 1.0
shadow = true
# Floating panels retain their own glass instead of inheriting the invisible
# bar's opacity. "auto" places keyboard-opened panels beneath the top bar.
launcher_placement = "floating"
launcher_position = "auto"
clipboard_placement = "floating"
clipboard_position = "auto"
control_center_placement = "floating"
control_center_position = "auto"
wallpaper_placement = "floating"
wallpaper_position = "auto"
session_placement = "floating"
session_position = "auto"
floating_offset = 6

[shell.shadow]
direction = "down"
alpha = 0.6

[shell.launcher]
layout = "simple"
# No category chip row above the results; search covers it.
categories = false
show_app_origin_indicator = false
fetch_exchange_rates = false

[shell.screenshot]
directory = "{{ desktop_home }}/Pictures/Screenshots"
copy_to_clipboard = true
save_to_file = true

[theme]
mode = "dark"
source = "custom"
custom_palette = "Graphite"
# Color templates for other apps stay off: GTK, Qt, Ghostty and Starship get
# stable, hand-written configs from Ansible instead of generated CSS.
[theme.templates]
enable_builtin_templates = false
enable_community_templates = false

[wallpaper]
enabled = true
fill_mode = "crop"
fill_color = "#0a0a0b"
directory = "{{ desktop_home }}/.local/share/backgrounds"
transition = ["fade"]
transition_duration = 600

[wallpaper.default]
path = {{ niri_wallpaper_path | to_json }}

# The wallpaper is placed on Niri's backdrop (see config.kdl), so Noctalia's
# separate backdrop layer stays off.
[backdrop]
enabled = false

[notification]
background_opacity = 0.78
border = true
border_color = "outline_variant"
offset_x = 16
offset_y = 12

[osd]
position = "bottom_center"
background_opacity = 0.78
border = true
border_color = "outline_variant"

[lockscreen]
enabled = true
lock_before_suspend = true
blurred_desktop = false
transition = ["fade"]
transition_duration = 500
blur_intensity = 0.7
tint_intensity = 0.45

[idle]
behavior_order = ["lock", "screen-off", "suspend"]
pre_action_fade_seconds = 3.0

[idle.behavior.lock]
action = "lock"
timeout = {{ niri_idle_lock_seconds }}
enabled = {{ (niri_idle_lock_seconds | int > 0) | lower }}

[idle.behavior.screen-off]
action = "screen_off"
timeout = {{ niri_idle_screen_off_seconds }}
enabled = {{ (niri_idle_screen_off_seconds | int > 0) | lower }}

[idle.behavior.suspend]
action = "lock_and_suspend"
timeout = {{ niri_idle_suspend_seconds }}
enabled = {{ (niri_idle_suspend_seconds | int > 0) | lower }}

[bar.main]
position = "top"
layer = "top"
reserve_space = true
thickness = 34
# Only the center capsule is visible. Blur and shadow here would still cover
# the entire bar, including the transparent area outside the notch.
background_opacity = 0.0
compositor_blur = false
shadow = false
border_width = 0.0
margin_edge = 0
margin_ends = 0
padding = 0
capsule = false
capsule_thickness = 0.82
font_weight = 500
hover_highlight = true
show_tooltip = true
start = []
center = ["group:notch"]
end = []

[bar.main.dead_zone]
click_through = true

# Noctalia 5.4.1, 2026-11-06: this steady capsule group is the notch.
# A center-lane accordion re-centers on hover and moves the clock away from
# the pointer. Keep the row visible and let the native panels animate instead.
[[bar.main.capsule_group]]
id = "notch"
members = ["workspaces", "media", "clock", "network", "volume", "bluetooth", "battery", "notifications", "tray"]
fill = "surface"
opacity = 0.92
border = "outline_variant"
border_width = 1.0
foreground = "on_surface"
padding = 10.0
widget_spacing = 10

[widget.clock]
format = "{:%H:%M}"
tooltip_format = "{:%A, %B %d}"
font_weight = 600

[widget.clock.actions]
left = "panel-toggle control-center"

# Numbered pills. The active one is white with dark text and only slightly
# longer than the round inactive ones; occupied workspaces get a lighter gray
# fill than empty ones. Fill colors use roles, so labels pick the matching
# readable text color.
[widget.workspaces]
style = "regular"
show_labels = true
label_source = "id"
active_pill_size = 1.5
inactive_pill_size = 1.0
focused_color = "primary"
occupied_color = "outline_variant"
empty_color = "hover"

[widget.media]
album_art_only = true
hide_when_no_media = true

[widget.network]
show_label = false

[widget.volume]
show_label = false

[widget.bluetooth]
show_label = false
hide_when_no_connected_device = true

[widget.battery]
display_mode = "graphic"
show_label = true

[widget.notifications]
hide_when_no_unread = true

[widget.tray]
drawer = true
detached_panel = true

[dock]
enabled = true
position = "bottom"
launcher_position = "start"
icon_size = 44
background_opacity = 0.62
compositor_blur = true
radius = 18
margin_edge = 8
shadow = true
auto_hide = true
reserve_space = false
magnification = false
show_dots = true
show_instance_count = false
inactive_opacity = 1.0
pinned = {{ niri_dock_pinned | to_json }}
