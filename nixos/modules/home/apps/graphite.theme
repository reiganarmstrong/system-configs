# Shared with the Fedora Graphite profile.
# Graphite for btop: gray boxes and graphs; temperature and usage meters move
# from gray through yellow to red so pressure still reads at a glance.

theme[main_bg]="#0a0a0b"
theme[main_fg]="#e6e6e8"
theme[title]="#ececee"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#26262a"
theme[selected_fg]="#ffffff"
theme[inactive_fg]="#5a5a61"
theme[graph_text]="#a3a3a9"
theme[meter_bg]="#26262a"
theme[proc_misc]="#a3a3a9"
theme[cpu_box]="#3a3a3f"
theme[mem_box]="#3a3a3f"
theme[net_box]="#3a3a3f"
theme[proc_box]="#3a3a3f"
theme[div_line]="#2a2a2e"

theme[temp_start]="#7c7c83"
theme[temp_mid]="#d4a95a"
theme[temp_end]="#e5534b"

theme[cpu_start]="#7c7c83"
theme[cpu_mid]="#c8c8cc"
theme[cpu_end]="#e5534b"

theme[free_start]="#3a3a3f"
theme[free_mid]="#7c7c83"
theme[free_end]="#c8c8cc"

theme[cached_start]="#3a3a3f"
theme[cached_mid]="#7c7c83"
theme[cached_end]="#c8c8cc"

theme[available_start]="#3a3a3f"
theme[available_mid]="#7c7c83"
theme[available_end]="#c8c8cc"

theme[used_start]="#7c7c83"
theme[used_mid]="#d4a95a"
theme[used_end]="#e5534b"

theme[download_start]="#3a3a3f"
theme[download_mid]="#7c7c83"
theme[download_end]="#e6e6e8"

theme[upload_start]="#3a3a3f"
theme[upload_mid]="#7c7c83"
theme[upload_end]="#e6e6e8"

theme[process_start]="#7c7c83"
theme[process_mid]="#c8c8cc"
theme[process_end]="#ffffff"
