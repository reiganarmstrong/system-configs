#!/usr/bin/env python3
"""Fake desktop-settings: saving showSeconds=true always fails."""
import json, os, sys
state = os.path.join(os.environ["FAKE_STATE"], "preferences.json")
values = json.load(open(state)) if os.path.exists(state) else {}
action = sys.argv[1]
if action == "get":
    print(json.dumps({"preferences": values, "defaults": {}, "monitors": [], "system": {}}))
elif action == "save":
    new = json.loads(sys.argv[2])
    if new.get("showSeconds"):
        print(json.dumps({"error": "Simulated save failure"}))
        sys.exit(1)
    json.dump(new, open(state, "w"))
    print(json.dumps({"preferences": new}))
else:
    print(json.dumps({"error": "unexpected " + action}))
    sys.exit(1)
