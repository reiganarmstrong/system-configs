# Managed by Ansible. GUI overrides for these settings are cleared on each run.
[theme]
# The complete legacy palette supports Noctalia 5.4.1's shell renderer.
source = "custom"
custom_palette = "macos"
mode = "{{ desktop_theme_mode }}"
shell_mode = "follow"

[shell]
font_family = "Inter"
corner_radius_scale = 1.15

[shell.animation]
enabled = false

[shell.panel]
# Niri applies the shared subtle opacity to these panel surfaces.
transparency_mode = "solid"
border_color = "outline_variant"
border_width = 1.0
shadow = true

[shell.shadow]
alpha = 0.22

[bar.main]
background_opacity = {{ desktop_glass | ternary(desktop_surface_opacity, 1.0) }}
compositor_blur = {{ desktop_blur | ternary('true', 'false') }}

[widget.workspaces]
occupied_color = "#FFFFFF"
empty_color = "#FFFFFF"
change_color_on_hover = false

[dock]
background_opacity = {{ desktop_glass | ternary(desktop_surface_opacity, 1.0) }}
compositor_blur = {{ desktop_blur | ternary('true', 'false') }}

[notification]
background_opacity = {{ desktop_glass | ternary(0.97, 1.0) }}

[osd]
background_opacity = {{ desktop_glass | ternary(0.97, 1.0) }}

[backdrop]
enabled = false
blur_intensity = 0.0

[lockscreen]
blurred_desktop = false
blur_intensity = 0.0
