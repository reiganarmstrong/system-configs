# Managed by Ansible.
[window]
opacity = {{ desktop_glass | ternary(0.82, 1.0) }}
blur = {{ desktop_glass | ternary('true', 'false') }}
padding = { x = 16, y = 14 }

[font]
size = 12.0

[colors.primary]
background = "{{ '#1C1C1E' if desktop_theme_mode == 'dark' else '#F5F5F7' }}"
foreground = "{{ '#F5F5F7' if desktop_theme_mode == 'dark' else '#1D1D1F' }}"

[colors.cursor]
text = "#FFFFFF"
cursor = "#007AFF"

[colors.selection]
text = "#1D1D1F"
background = "#B4D8FF"
