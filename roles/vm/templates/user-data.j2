#cloud-config
hostname: {{ vm_name }}
manage_etc_hosts: true
users:
  - name: {{ vm_user }}
    groups: [wheel]
    shell: /bin/bash
    lock_passwd: true
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - {{ lookup('file', vm_private_key + '.pub') | to_json }}
disable_root: true
ssh_pwauth: false
