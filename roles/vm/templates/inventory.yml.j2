---
desktops:
  hosts:
    fedora_vm:
      ansible_host: {{ vm_ip }}
      ansible_user: {{ vm_user }}
      ansible_ssh_private_key_file: {{ vm_private_key | to_json }}
  vars:
    ansible_ssh_common_args: {{ ('-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=' + vm_local_directory + '/known_hosts') | to_json }}
    desktop_user: {{ vm_user }}
    desktop_vm: true
    desktop_autologin: true
    desktop_output: Virtual-1
